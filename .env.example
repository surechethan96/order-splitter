# Copy to .env and change what you need. Every value is optional.

PORT=3000

# Decimal places allowed for share quantities (0 to 8). 3 today, could be 7 later.
QUANTITY_DECIMALS=3

# Fixed price used when the partner does not send a price.
DEFAULT_STOCK_PRICE=100

# Market hours. The market is open Monday to Friday between these times.
MARKET_TIMEZONE=America/New_York
MARKET_OPEN=09:30
MARKET_CLOSE=16:00
# Extra days the market is closed, e.g. 2026-11-26,2026-12-25. Empty = none.
MARKET_HOLIDAYS=

# Max orders kept in memory. The oldest are dropped first.
MAX_STORED_ORDERS=10000

# Max Idempotency-Keys kept in memory (must be at least MAX_STORED_ORDERS).
# Keys outlive their orders, so a late retry gets a 409 instead of creating a duplicate.
MAX_IDEMPOTENCY_KEYS=100000
